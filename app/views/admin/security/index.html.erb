<% content_for :page_title, t("security.title") %>
<div class="app-page-heading">
  <div>
    <p class="app-eyebrow"><%= ui_icon("shield", size: 17) %><%= t("security.eyebrow") %></p>
    <h1><%= t("security.title") %></h1>
    <p class="app-page-description"><%= t("security.description") %></p>
  </div>
  <span class="app-status-pill"><%= ui_icon("check-circle", size: 16, class_name: "text-[var(--success)]") %><%= t("layout.security_summary") %></span>
</div>

<div class="mb-7 grid gap-4 md:grid-cols-3">
  <% [
    ["user", t("security.admin_accounts"), @admin_count],
    ["shield", t("security.throttle_buckets"), @active_throttle_buckets],
    ["clock", t("security.session_policy"), t("security.session_limits")]
  ].each do |icon, label, value| %>
    <section class="app-stat-card">
      <span class="app-panel-icon"><%= ui_icon(icon) %></span>
      <p class="text-xs font-semibold text-[var(--muted)]"><%= label %></p>
      <p class="app-stat-value"><%= value %></p>
    </section>
  <% end %>
</div>

<section class="app-panel mb-7">
  <div class="app-panel-content">
    <h2 class="app-panel-heading"><span class="app-panel-icon"><%= ui_icon("lock") %></span><%= t("security.login_protection") %></h2>
    <p class="text-sm leading-relaxed text-[var(--text)]"><%= t("security.login_limits") %></p>
    <p class="mt-4 rounded-xl border border-[var(--border-soft)] bg-[var(--input)] px-4 py-3 text-xs leading-relaxed text-[var(--muted)]"><%= t("security.throttle_note") %></p>
  </div>
</section>

<div class="grid gap-7 xl:grid-cols-2">
  <section class="app-panel">
    <div class="app-panel-content">
      <h2 class="app-panel-heading"><span class="app-panel-icon"><%= ui_icon("history") %></span><%= t("security.events") %></h2>
      <% if @security_events.any? %>
        <div class="divide-y divide-[var(--border-soft)]">
          <% @security_events.each do |event| %>
            <div class="flex flex-wrap items-start justify-between gap-3 py-4 text-sm">
              <span class="flex min-w-0 items-start gap-3">
                <%= ui_icon(event.event_type == "login_success" ? "check-circle" : "shield", size: 18, class_name: "mt-0.5 shrink-0 text-[var(--accent)]") %>
                <span class="min-w-0">
                  <strong class="block font-semibold"><%= t("security.event_types.#{event.event_type}") %></strong>
                  <span class="mt-1 block break-all text-xs text-[var(--muted)]"><%= event.user&.email || t("security.unknown_user") %></span>
                </span>
              </span>
              <time class="text-xs text-[var(--muted)]"><%= l(event.created_at, format: :long) %></time>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="app-empty-state">
          <div class="app-empty-icon"><%= ui_icon("clock", size: 25) %></div>
          <p><%= t("security.no_events") %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="app-panel">
    <div class="app-panel-content">
      <h2 class="app-panel-heading"><span class="app-panel-icon"><%= ui_icon("list-checks") %></span><%= t("security.settings_audit") %></h2>
      <% if @setting_events.any? %>
        <div class="divide-y divide-[var(--border-soft)]">
          <%= render partial: "admin/settings/audit_event", collection: @setting_events, as: :event %>
        </div>
      <% else %>
        <div class="app-empty-state">
          <div class="app-empty-icon"><%= ui_icon("file-text", size: 25) %></div>
          <p><%= t("security.no_events") %></p>
        </div>
      <% end %>
    </div>
  </section>
</div>
