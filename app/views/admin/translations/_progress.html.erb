<% total = runs.length %>
<% completed = runs.count { |run| run.status == "completed" } %>
<% failed = runs.count { |run| run.status == "failed" } %>
<% uncertain = runs.count { |run| run.status == "uncertain" } %>
<% processed = completed + failed + uncertain %>
<% processing = total - processed %>
<% percentage = total.positive? ? (processed * 100.0 / total).round : 0 %>
<section id="translation_progress_<%= translation.id %>" class="app-panel mb-8" aria-label="<%= t('history.progress_title') %>">
  <div class="app-panel-content">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-[var(--text-strong)]"><%= t("history.progress_title") %></h2>
        <p class="mt-1 text-sm text-[var(--muted)]">
          <%= t("history.progress_count", processed: processed, total: total, percent: percentage) %>
        </p>
      </div>
      <span class="rounded-full border border-[var(--border)] px-3 py-1 text-xs font-semibold text-[var(--text)]">
        <%= t("statuses.#{translation.status}", default: translation.status.humanize) %>
      </span>
    </div>
    <div class="mt-4 h-2.5 overflow-hidden rounded-full bg-[var(--border-soft)]"
      role="progressbar" aria-label="<%= t('history.progress_title') %>"
      aria-valuemin="0" aria-valuemax="<%= total %>" aria-valuenow="<%= processed %>">
      <div class="h-full rounded-full bg-[var(--accent)] transition-all duration-300" style="width: <%= percentage %>%"></div>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-[var(--muted)]">
      <%= t("history.progress_breakdown", completed: completed, failed: failed, uncertain: uncertain, processing: processing) %>
    </p>
    <p class="mt-1 text-xs leading-relaxed text-[var(--muted)]"><%= t("history.progress_explanation") %></p>
  </div>
</section>
