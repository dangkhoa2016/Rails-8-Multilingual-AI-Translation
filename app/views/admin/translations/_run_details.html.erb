<% usage = run.provider_usage %>
<% timings = run.provider_timings %>
<% resources = run.provider_resources %>
<% response = run.provider_response %>
<details class="mt-4 min-w-0 max-w-full rounded-xl border border-[var(--border-soft)] bg-[var(--input)] p-4 text-sm">
  <summary class="cursor-pointer font-semibold text-[var(--accent)]"><%= t("history.technical_details") %></summary>
  <div class="mt-4 min-w-0 space-y-4">
    <dl class="grid grid-cols-1 gap-3 text-xs sm:grid-cols-2">
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.rails_elapsed") %></dt>
        <dd class="mt-1 font-semibold text-[var(--text)]">
          <%= run.dispatch_elapsed_seconds ? t("history.seconds_value", value: number_with_precision(run.dispatch_elapsed_seconds, precision: 2)) : t("history.not_available") %>
        </dd>
      </div>
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.poll_count") %></dt>
        <dd class="mt-1 font-semibold text-[var(--text)]"><%= run.translation_dispatch&.poll_attempts || t("history.not_available") %></dd>
      </div>
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.provider_timing") %></dt>
        <dd class="mt-1 text-[var(--text)]"><%= timings.present? ? timings.map { |key, value| "#{key}: #{value}" }.join(" · ") : t("history.provider_not_reported") %></dd>
      </div>
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.token_usage") %></dt>
        <dd class="mt-1 text-[var(--text)]">
          <% if usage.present? %>
            <%= usage.map { |key, value| "#{key}: #{value}" }.join(" · ") %>
          <% else %>
            <%= t("history.provider_not_reported") %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.resource_usage") %></dt>
        <dd class="mt-1 text-[var(--text)]">
          <%= resources.present? ? resources.map { |key, value| "#{key}: #{value}" }.join(" · ") : t("history.provider_not_reported") %>
        </dd>
        <p class="mt-1 text-[var(--muted)]"><%= t("history.resource_usage_note") %></p>
      </div>
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.dispatch_started_at") %></dt>
        <dd class="mt-1 text-[var(--text)]"><%= run.translation_dispatch&.started_at ? l(run.translation_dispatch.started_at, format: :long) : t("history.not_available") %></dd>
      </div>
      <div>
        <dt class="text-[var(--muted)]"><%= t("history.dispatch_resolved_at") %></dt>
        <dd class="mt-1 text-[var(--text)]"><%= run.translation_dispatch&.resolved_at ? l(run.translation_dispatch.resolved_at, format: :long) : t("history.not_available") %></dd>
      </div>
    </dl>

    <div class="min-w-0 border-t border-[var(--border-soft)] pt-4">
      <h4 class="font-semibold text-[var(--text-strong)]"><%= t("history.response_snapshot") %></h4>
      <% if response.present? %>
        <p class="mt-2 text-xs leading-relaxed text-[var(--muted)]"><%= t("history.response_snapshot_note") %></p>
        <pre class="translation-raw-response"><%= JSON.pretty_generate(response) %></pre>
      <% else %>
        <p class="mt-2 text-xs leading-relaxed text-[var(--muted)]"><%= t("history.response_unavailable") %></p>
        <p class="mt-3 text-xs font-semibold text-[var(--text)]"><%= t("history.locally_recorded") %></p>
        <pre class="translation-raw-response"><%= JSON.pretty_generate(run.recorded_response) %></pre>
      <% end %>
    </div>
  </div>
</details>
